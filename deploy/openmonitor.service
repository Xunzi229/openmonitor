[Unit]
Description=OpenMonitor GPT price watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/openmonitor
ExecStart=/usr/bin/python3 /opt/openmonitor/monitor.py --watch -c /opt/openmonitor/config.json
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
