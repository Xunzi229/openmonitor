{
  "interval_seconds": 60,
  "shop_update_interval_minutes": 20,
  "shops_per_batch": 10,
  "shop_fetch_delay_min_sec": 2,
  "shop_fetch_delay_max_sec": 3,
  "page_size": 100,
  "push_schedule": {
    "weekdays": [
      1,
      2,
      3,
      4,
      5
    ],
    "time_ranges": [
      {
        "start": "09:30",
        "end": "14:00"
      }
    ]
  },
  "monitor_keywords": [
    "gpt",
    "chatgpt"
  ],
  "categories": [
    {
      "name": "免费号",
      "keywords": [
        "free",
        "免费",
        "白嫖"
      ],
      "top_n": 5,
      "enabled": true,
      "push": false,
      "max_push_price": 12,
      "description": "实际售卖免费/白嫖的 ChatGPT 账号本身；接码、邮箱等辅助服务不算。"
    },
    {
      "name": "Plus号",
      "keywords": [
        "plus",
        "plus号",
        "plus帐",
        "plus账"
      ],
      "top_n": 5,
      "enabled": true,
      "max_push_price": 20,
      "description": "实际售卖 ChatGPT Plus 官方会员账号/订阅/席位本身（如成品号、独享月卡、质保首登会员）。以下绝不是 Plus号：接码/验证码/邮箱/绑定工具；中转站、镜像站、API 中转；标题含「xx刀/20刀/plus20刀」等额度或中转套餐（如「plus20刀不限时」）；CDK、卡头、次卡、直卡、支付链接、虚拟卡、「开通plus必备」等支付开通工具。"
    },
    {
      "name": "Team号",
      "keywords": [
        "team",
        "团队"
      ],
      "top_n": 5,
      "enabled": true,
      "push": false,
      "max_push_price": 20,
      "description": "实际售卖 ChatGPT Team 账号或团队席位本身；接码/邮箱/中转站/镜像站/xx刀额度等不算。"
    },
    {
      "name": "Pro号",
      "keywords": [
        "pro"
      ],
      "top_n": 5,
      "enabled": false,
      "push": false,
      "description": "实际售卖 ChatGPT Pro 账号或订阅本身；接码/邮箱/中转站/镜像站/xx刀额度等不算。"
    },
    {
      "name": "其他GPT",
      "keywords": [],
      "top_n": 5,
      "enabled": true,
      "fallback": true,
      "push": false,
      "max_push_price": 12,
      "description": "不属于以上任一精准分类的 GPT 相关商品，包括接码、邮箱、绑定工具、中转站、镜像站、xx刀额度套餐、杂项服务等。"
    },
    {
      "name": "UPI",
      "keywords": [
        "upi"
      ],
      "top_n": 5,
      "enabled": true,
      "push": false,
      "max_push_price": 20,
      "description": "实际与 UPI 支付或开通相关的商品。"
    },
    {
      "name": "重置",
      "keywords": [
        "重置"
      ],
      "top_n": 5,
      "enabled": true,
      "push": false,
      "max_push_price": 20,
      "description": "实际是账号重置类服务。"
    }
  ],
  "alert_rules": {
    "push_on_price_drop": true,
    "push_on_top10_new_entry": true
  },
